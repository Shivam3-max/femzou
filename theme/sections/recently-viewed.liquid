{%- comment -%} Filled in the browser from the visitor's own history; hidden until there is something to show. {%- endcomment -%}
<section class="sec recent" data-recent hidden>
  <div class="wrap">
    <div class="head head--split">
      <h2 class="head__h">{{ section.settings.heading }}</h2>
      <button class="textlink" type="button" data-recent-clear>Clear</button>
    </div>
    <div class="rail" data-rail>
      <div class="rail__track" data-rail-track data-drag data-recent-track></div>
      <button class="rail__btn rail__btn--l" type="button" data-rail-prev aria-label="Previous products" hidden>{% render 'icon', name: 'left' %}</button>
      <button class="rail__btn rail__btn--r" type="button" data-rail-next aria-label="More products" hidden>{% render 'icon', name: 'right' %}</button>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Recently viewed", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" } ], "presets": [ { "name": "Recently viewed" } ] }
{% endschema %}
