<section class="sec" data-tabs>
  <div class="wrap">
    <div class="head head--center">
      <h2 class="head__h">{{ section.settings.heading }}</h2>
      <div class="tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button class="tab{% if forloop.first %} is-on{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div class="tabpanel" data-tabpanel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
        {%- render 'product-rail', rail_products: block.settings.collection.products, rail_limit: 10, skip_handle: '' -%}
        <div class="center"><a class="btn btn--line" href="{{ block.settings.collection.url }}">View all {{ block.settings.label }}</a></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Tabbed products",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" } ],
  "max_blocks": 5,
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Face" },
      { "type": "collection", "id": "collection", "label": "Collection" }
    ] }
  ],
  "presets": [ { "name": "Tabbed products", "blocks": [
    { "type": "tab", "settings": { "label": "Face Care", "collection": "face-care" } },
    { "type": "tab", "settings": { "label": "Hair Care", "collection": "hair-care" } },
    { "type": "tab", "settings": { "label": "Body & Hygiene", "collection": "body-hygiene" } }
  ] } ]
}
{% endschema %}
