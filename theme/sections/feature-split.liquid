<section class="sec sec--tight">
  <div class="wrap split{% if section.settings.flip %} split--flip{% endif %}">
    <div class="split__media">
      {%- render 'media-slot', image: section.settings.image, label: section.settings.image_label, spec: '1200 × 900', class_name: 'slot--split', alt_text: section.settings.heading, widths_attr: '(min-width: 900px) 50vw, 100vw' -%}
    </div>
    <div class="split__copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="split__h">{{ section.settings.heading }}</h2>
      <p class="split__p">{{ section.settings.text }}</p>
      <a class="btn" href="{{ section.settings.link }}">{{ section.settings.button }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image and text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "1200 × 900" },
    { "type": "text", "id": "image_label", "label": "Placeholder label", "default": "Feature image" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Feature" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Image and text" } ]
}
{% endschema %}
