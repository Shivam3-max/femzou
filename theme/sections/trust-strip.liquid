<section class="trust" aria-label="Our promises">
  <div class="wrap trust__in">
    {%- for block in section.blocks -%}
      <div class="trust__i" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 6,
  "blocks": [
    { "type": "item", "name": "Promise", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "rabbit", "label": "Rabbit" }, { "value": "flask", "label": "Flask" },
        { "value": "drop", "label": "Drop" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }
      ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Promise" }
    ] }
  ],
  "presets": [ { "name": "Trust strip", "blocks": [
    { "type": "item", "settings": { "icon": "leaf", "text": "Paraben free" } },
    { "type": "item", "settings": { "icon": "drop", "text": "Sulphate-free cleansers" } },
    { "type": "item", "settings": { "icon": "rabbit", "text": "Cruelty free" } },
    { "type": "item", "settings": { "icon": "flask", "text": "Dermatologically tested" } },
    { "type": "item", "settings": { "icon": "shield", "text": "Made in India" } }
  ] } ]
}
{% endschema %}
