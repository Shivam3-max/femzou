{%- comment -%}
  Banners. Each banner can have a wide desktop artwork and a tall phone artwork.
  When no banner has desktop artwork yet, desktop shows the phone artworks side
  by side as cards instead of an empty wide slot.
{%- endcomment -%}
{%- assign has_desktop = false -%}
{%- for block in section.blocks -%}{%- if block.settings.image != blank -%}{%- assign has_desktop = true -%}{%- endif -%}{%- endfor -%}
<section class="hero{% unless has_desktop %} hero--cards{% endunless %}" data-hero aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="hero__frame">
    <div class="hero__track" data-hero-track>
      {%- for block in section.blocks -%}
        <a class="hero__slide" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- capture lbl -%}Hero banner {{ forloop.index }}{%- endcapture -%}
          {%- if has_desktop -%}
            {%- render 'media-slot', image: block.settings.image, label: lbl, spec: 'Desktop 1920 × 640', class_name: 'slot--hero slot--desk', alt_text: block.settings.alt, widths_attr: '100vw' -%}
          {%- endif -%}
          {%- assign phone_img = block.settings.image_mobile | default: block.settings.image -%}
          {%- render 'media-slot', image: phone_img, label: lbl, spec: 'Phone 1350 × 1650', class_name: 'slot--hero slot--phone', alt_text: block.settings.alt, widths_attr: '(min-width: 760px) 33vw, 100vw' -%}
        </a>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <button class="hero__arrow hero__arrow--l" type="button" data-hero-prev aria-label="Previous banner">{% render 'icon', name: 'left' %}</button>
      <button class="hero__arrow hero__arrow--r" type="button" data-hero-next aria-label="Next banner">{% render 'icon', name: 'right' %}</button>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}<button type="button" class="hero__dot{% if forloop.first %} is-on{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Go to banner {{ forloop.index }}"></button>{%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banners",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Featured" }
  ],
  "blocks": [
    { "type": "banner", "name": "Banner", "settings": [
      { "type": "image_picker", "id": "image", "label": "Desktop artwork", "info": "1920 × 640. Put all text in the artwork. Leave every banner's desktop artwork empty to show the phone artworks side by side on desktop." },
      { "type": "image_picker", "id": "image_mobile", "label": "Phone artwork", "info": "1350 × 1650." },
      { "type": "text", "id": "alt", "label": "Image description" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Hero banners", "blocks": [ { "type": "banner" }, { "type": "banner" }, { "type": "banner" } ] } ]
}
{% endschema %}
