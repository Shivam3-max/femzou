<div class="ann" data-ann>
  <div class="wrap ann__in">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a class="ann__msg{% if forloop.first %} is-on{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
      {%- else -%}
        <span class="ann__msg{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping above ₹499" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Announcement bar", "blocks": [
    { "type": "message", "settings": { "text": "Free shipping above ₹499. Cash on delivery available." } },
    { "type": "message", "settings": { "text": "Paraben free. Cruelty free. Made in India." } }
  ] } ]
}
{% endschema %}
