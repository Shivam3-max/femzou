<section class="news">
  <div class="wrap news__in">
    <div>
      <h2 class="news__h">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {%- form 'customer', class: 'news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" required placeholder="Your email address" aria-label="Email address">
      <button class="btn btn--light" type="submit">Subscribe</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the FemZou list for early access to launches, offers and care tips." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
