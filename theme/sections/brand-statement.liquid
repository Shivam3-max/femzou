<section class="sec statement">
  <div class="wrap statement__in">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="statement__h" data-type>{{ section.settings.heading }}</h2>
    <span class="statement__rule" aria-hidden="true"></span>
    <p class="statement__p">{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why FemZou" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty. Science. Confidence." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Skin, hair and body care built around ingredients that do real work, in formulas gentle enough for every day. Free from parabens, never tested on animals, and made in India." }
  ],
  "presets": [ { "name": "Brand statement" } ]
}
{% endschema %}
